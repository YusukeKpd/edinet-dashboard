# Streamlit Community Cloud の Secrets に貼る内容のテンプレート。
# 実ファイル .streamlit/secrets.toml は .gitignore 済み。絶対にコミットしないこと。

# GitHub Actions の workflow_dispatch を叩くためのトークン
# fine-grained PAT / 対象リポジトリの Actions: write のみ（仕様書 §7.2）
GITHUB_TOKEN = "github_pat_xxxxxxxx"

# データ管理ページを保護する管理者パスワード
ADMIN_PASSWORD = "change-me"

# owner/repo
REPO = "YusukeKpd/edinet-dashboard"
