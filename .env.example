# EDINET API v2 のサブスクリプションキー
# 取得: https://api.edinet-fsa.go.jp/ の「APIキー発行」から登録
# GitHub Actions では Secrets に EDINET_API_KEY として登録する
EDINET_API_KEY=

# Releases への読み書きに使うトークン (ローカル実行時のみ必要)
# Actions 上では標準の GITHUB_TOKEN + permissions.contents: write を使うため不要
GITHUB_TOKEN=

# owner/repo
REPO=YusukeKpd/edinet-dashboard
